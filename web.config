<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- LexiPack API → backend port 3002 -->
        <rule name="LexiPack API" stopProcessing="true">
          <match url="^lexipack/api/(.*)" />
          <action type="Rewrite" url="http://localhost:3002/api/{R:1}" />
        </rule>

        <!-- LexiPack frontend → pm2 serve port 4001 -->
        <rule name="LexiPack Frontend" stopProcessing="true">
          <match url="^lexipack/(.*)" />
          <action type="Rewrite" url="http://localhost:4001/{R:1}" />
        </rule>

        <!-- LexiPack root redirect -->
        <rule name="LexiPack Root" stopProcessing="true">
          <match url="^lexipack$" />
          <action type="Redirect" url="/lexipack/" redirectType="Permanent" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>
