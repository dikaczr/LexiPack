      "word": "signal",
      "article": "",
      "phonetic": "/ˈsɪɡnəl/",
      "translation": "signál",
      "definition": "A transmitted indication, impulse, or message used to convey information in a system or process.",
      "type": "noun",
      "level": "B1",
      "example_en": "The engineer measured the signal from the sensor to check the stability of the control system.",
      "example_sk": "Inžinier meral signál zo senzora, aby skontroloval stabilitu riadiaceho systému.",
      "topic": "engineering",
      "source": "Elektrotechnika IV - Radio-Frequency Engineering, "
    },
